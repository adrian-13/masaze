# Copy this file to `.env` and fill in the values.

# Database connection (libSQL / SQLite).
# Local development: a file. Production (Vercel): a Turso libsql:// URL.
DATABASE_URL="file:./dev.db"

# Auth token for hosted Turso databases. Leave empty for the local file.
DATABASE_AUTH_TOKEN=""

# Password the masseuse uses to log in to the admin panel at /admin.
ADMIN_PASSWORD="zmen-ma-heslo"

# Secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="vygenerujte-nahodny-retazec"

# --- E-mailové notifikácie (Resend) ---
# Nepovinné: ak nie sú vyplnené RESEND_API_KEY aj MAIL_FROM, e-maily sa
# jednoducho neodosielajú a zvyšok stránky funguje normálne.

# API kľúč z https://resend.com (Account → API Keys).
RESEND_API_KEY=""

# Odosielateľ. Doména musí byť overená v Resend (napr. "Masáže <rezervacie@vasadomena.sk>").
MAIL_FROM=""

# Kam chodia notifikácie o nových rezerváciách. Ak je prázdne, použije sa
# kontaktný e-mail z nastavení administrácie.
OWNER_EMAIL=""

# Verejná adresa webu (pre správne URL OG obrázka pri zdieľaní odkazu).
# Napr. "https://masazeklara.sk". Na Verceli sa dá vynechať (použije sa
# automatická Vercel adresa); lokálne sa použije http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# --- Vzhľad (seed dizajnu) ---
# Ľubovoľný text. Z neho sa deterministicky vygeneruje celá téma (farby,
# písma, tvary). Rovnaký seed = rovnaký vzhľad. Zmenou získate nový unikátny
# dizajn. Náhľad rôznych seedov: `npm run design:preview` → theme-preview.html
DESIGN_SEED="masaze"
