# Copy this file to `.env` and fill in the values.

# Database connection (libSQL / SQLite).
# Local development uses a file; for production use a hosted libSQL/Turso URL.
DATABASE_URL="file:./dev.db"

# Password the masseuse uses to log in to the admin panel at /admin.
ADMIN_PASSWORD="zmen-ma-heslo"

# Secret used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="vygenerujte-nahodny-retazec"
